generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Audit {
  id             String      @id @default(cuid())
  companyName    String?     @default("Your Company")
  companySize    Int
  industry       String?
  totalSpend     Float
  optimizedSpend Float
  savings        Float
  currency       String      @default("USD")
  aiSummary      String?
  isPublic       Boolean     @default(false)
  publicSlug     String?     @unique
  referralCode   String?     // Track the source
  leadId         String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  lead           Lead?       @relation(fields: [leadId], references: [id])
  tools          AuditTool[]
}

model AuditTool {
  id             String   @id @default(cuid())
  auditId        String
  toolName       String
  currentPlan    String
  seats          Int
  monthlySpend   Float
  type           String   @default("SEAT")
  useCases       String[]
  suggestedTool  String?
  suggestedPlan  String?
  suggestedSpend Float?
  reasoning      String?
  audit          Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

model Lead {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  company        String?
  role           String?
  teamSize       Int?
  referralCode   String   @unique @default(nanoid(8))
  referredById   String?
  referredBy     Lead?    @relation("ReferralTree", fields: [referredById], references: [id])
  referrals      Lead[]   @relation("ReferralTree")
  createdAt      DateTime @default(now())
  audits         Audit[]
}
